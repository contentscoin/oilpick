# apps/user 환경변수 (03-frontend.md "Capacitor 설정" 절).
# 실제 값은 .env.development / .env.production으로 복사해 채운다(둘 다 .gitignore 대상).

# supabase status(로컬) 또는 프로젝트 대시보드에서 확인.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# 카카오 주소검색 API 키(AddressField). 비워두면 수동 텍스트 입력 폴백.
# (지도 렌더러는 11-map-renderer.md M8로 MapLibre 전환 — 지도에는 이 키를 쓰지 않는다.)
VITE_KAKAO_KEY=

# 지도 타일(MapLibre). 스타일 JSON URL 또는 {z}/{x}/{y} 래스터 템플릿(VWorld 권장).
# 비워두면 MapView는 일러스트 프리뷰를 렌더한다.
VITE_MAP_STYLE_URL=

# (선택) VWorld 인증키 — 주소검색 지오코딩(AddressField). 미설정 시 위 MAP_STYLE_URL(VWorld
# 타일 URL)에서 키를 자동 추출해 재사용한다. 둘 다 없으면 주소→좌표는 수동 입력 폴백.
# VITE_VWORLD_KEY=  ← 제거됨(12 S2 재설계). 지오코딩 키는 서버 시크릿 VWORLD_KEY로 이동.
#   Supabase 대시보드 → Edge Functions → Secrets 에 VWORLD_KEY 등록.

# (선택, 09 레퍼럴) 추천 랜딩(/ref/:code)의 스토어 버튼 링크. 미설정 시 버튼 비노출 —
# 앱스토어/플레이스토어 출시 후 실제 URL을 채운다(DEPLOY.md §2).
# VITE_APP_STORE_URL=
# VITE_PLAY_STORE_URL=
