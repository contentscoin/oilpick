# apps/rider 환경변수 (03-frontend.md "Capacitor 설정" 절).
# 실제 값은 .env.development / .env.production으로 복사해 채운다(둘 다 .gitignore 대상).

# supabase status(로컬) 또는 프로젝트 대시보드에서 확인.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# 카카오맵 JS SDK / 주소검색 API 키. 이 개발 환경에는 발급된 키가 없다(04-tasks.md 질문 목록).
# 비워두면 MapView는 자리표시자 UI를 렌더한다.
VITE_KAKAO_KEY=

# 토스페이먼츠 결제위젯 "클라이언트 키"(07 F4). 시크릿 키가 아니라 브라우저 번들에 유입돼도 되는
# 공개 키다. 시크릿 키(TOSS_SECRET_KEY)는 supabase secrets(Edge Function)에만 두고 여기 절대 넣지 말 것.
# 가맹/테스트 키 발급 전에는 비워둔다 → 결제 화면이 "키 미발급" 안내로 폴백한다.
# 테스트 키 발급 후: 토스 개발자센터 결제위젯 "클라이언트 키"(test_ck_...)를 채운다.
VITE_TOSS_CLIENT_KEY=

# 활성 PG(07 F14). "koem"=코엠(SIMPLEPAY) 결제창(위젯 미사용). "demo"=데모 결제(결제창 없이
# 곧장 충전 — 코엠 실연결 전 시연·개발용, 실 과금 없음. 실 라이더 운영 배포 금지 — DEPLOY.md).
# 서버 secrets의 PG_PROVIDER와 반드시 같은 값으로 맞출 것. 비우면 toss(키 미발급 시 수동 충전 안내).
VITE_PG_PROVIDER=demo
