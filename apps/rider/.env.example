# apps/rider 환경변수 (03-frontend.md "Capacitor 설정" 절).
# 실제 값은 .env.development / .env.production으로 복사해 채운다(둘 다 .gitignore 대상).

# supabase status(로컬) 또는 프로젝트 대시보드에서 확인.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# 지도 타일(11-map-renderer.md M8 — MapLibre 렌더러). MapLibre 스타일 JSON URL 또는
# {z}/{x}/{y} 래스터 타일 템플릿(한국 커버리지는 VWorld 권장 — 키 발급·도메인 등록 필요).
# 비워두면 MapView는 일러스트 프리뷰를 렌더한다. 길찾기는 카카오맵/TMap 앱 딥링크(키 불필요).
VITE_MAP_STYLE_URL=

# [17 Q3] 수거쿠폰 복권 — 쿠폰 결제 환경변수 복원(07 F4/F14 원형, src/lib/env.ts 참조).
# 활성 PG(07 F14, 17 C3). "koem"=코엠(SIMPLEPAY) 결제창(위젯 미사용 — 프로덕션 기본).
# "demo"=데모 결제(결제창 없이 곧장 충전 — 코엠 키 발급 전 시연·개발용, 실 과금 없음.
# 실 라이더 운영 배포 금지 — DEPLOY.md). 서버 secrets의 PG_PROVIDER와 반드시 같은 값으로
# 맞출 것. 비우면 toss(레거시 — 클라이언트 키 미발급 시 수동 충전 안내).
VITE_PG_PROVIDER=demo

# 토스페이먼츠 결제위젯 "클라이언트 키"(07 F4 레거시 분기 전용). 시크릿 키가 아니라 브라우저
# 번들에 유입돼도 되는 공개 키다. 시크릿 키(TOSS_SECRET_KEY)는 supabase secrets(Edge Function)
# 에만 두고 여기 절대 넣지 말 것. 코엠/데모 모드에서는 불필요 — 비워둔다.
VITE_TOSS_CLIENT_KEY=
