# apps/admin 환경변수 (03-frontend.md "Capacitor 설정" 절 — admin도 동일 변수 사용).
# 실제 값은 .env.development / .env.production으로 복사해 채운다(둘 다 .gitignore 대상).

# supabase status(로컬) 또는 프로젝트 대시보드에서 확인.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# 카카오맵 JS SDK API 키. 이 개발 환경에는 발급된 키가 없다(04-tasks.md 질문 목록).
# 비워두면 대시보드 MapView는 자리표시자 UI를 렌더한다(리스트 보조 표시로 대체 확인 가능).
VITE_KAKAO_KEY=
