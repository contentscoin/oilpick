# apps/admin 환경변수 (03-frontend.md "Capacitor 설정" 절 — admin도 동일 변수 사용).
# 실제 값은 .env.development / .env.production으로 복사해 채운다(둘 다 .gitignore 대상).

# supabase status(로컬) 또는 프로젝트 대시보드에서 확인.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# 지도 타일(11-map-renderer.md M8 — MapLibre 렌더러). 스타일 JSON URL 또는 {z}/{x}/{y} 래스터
# 템플릿(VWorld 권장). 비워두면 대시보드 MapView는 프리뷰를 렌더한다(리스트 보조 표시로 확인 가능).
